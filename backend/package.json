{
  "name": "trpc-express-template-backend",
  "version": "1.0.0",
  "description": "Express.js backend template with tRPC and authentication",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "npx tsc && npm run build:types",
    "build:types": "npx tsc --project tsconfig.declaration.json",
    "start": "node dist/server.js",
    "start:prod": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "lint:all": "biome lint src/ --reporter=json",
    "format": "biome check --write src/",
    "format:check": "biome check src/",
    "format:only": "biome format --write src/",
    "imports": "biome check --write src/",
    "imports:check": "biome check src/",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "watch": "tsc -w",
    "watch:types": "npx tsc --project tsconfig.declaration.json --watch"
  },
  "dependencies": {
    "@trpc/server": "^11.4.1",
    "@typegoose/typegoose": "^12.16.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/ui": "^3.2.4",
    "mongodb-memory-server": "^10.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "author": "",
  "license": "ISC"
}
